{
    "cli": {
        "version": ">= 24.8.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "node": "24.11.0",
            "android": {
                "buildType": "apk"
            },
            "environment": "development"
        },
        "preview": {
            "distribution": "internal",
            "node": "24.11.0",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_DEMO_TOOLS": "1"
            },
            "environment": "preview"
        },
        "preview-mock": {
            "extends": "preview",
            "env": {
                "EXPO_PUBLIC_FORCE_MOCK": "1"
            }
        },
        "production": {
            "autoIncrement": true,
            "node": "24.11.0",
            "environment": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
