[Unit]
Description=Remembrall backend slot %i
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/remembrall/deploy.conf
EnvironmentFile=/etc/remembrall/%i.env
WorkingDirectory=/home/ubuntu/apps/ktc4-chungnam-3/backend/Remembrall
ExecStart=/usr/bin/java -Xms256m -Xmx1536m -jar ${DEPLOY_ROOT}/slots/%i/app.jar --spring.config.additional-location=file:${APP_CONFIG} --notification.fcm-credentials-path=${FCM_CONFIG} --server.address=127.0.0.1 --server.port=${SERVER_PORT} --recall.agent.mode=llm --recall.agent.provider=google-genai --recall.agent.model=${RECALL_MODEL} --server.shutdown=graceful --spring.lifecycle.timeout-per-shutdown-phase=120s
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
SuccessExitStatus=143
UMask=0077

[Install]
WantedBy=multi-user.target
