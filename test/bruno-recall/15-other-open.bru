meta {
  name: RECALL-07 다른 회원 알림 열람 - 404
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/notifications/{{recallNotificationId}}/open
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{recallSessionB}}
}

script:pre-request {
  if (!bru.getVar("recallNotificationId")) { throw new Error("컬렉션을 처음부터 실행하세요: recallNotificationId가 없습니다."); }
  if (!bru.getVar("recallSessionB")) { throw new Error("컬렉션을 처음부터 실행하세요: recallSessionB가 없습니다."); }
}

tests {
  test("다른 회원 열람 변경 차단", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
  });
}

