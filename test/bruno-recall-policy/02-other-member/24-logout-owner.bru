meta {
  name: POL-OWNER-24 A 로그아웃 - 204
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{policyOwnerSession}}
}

script:pre-request {
  if (!bru.getVar("policyOwnerSession")) { throw new Error("이 폴더를 처음부터 실행하세요: policyOwnerSession가 없습니다."); }
}

tests {
  test("HTTP 204", function () { expect(res.status).to.equal(204); });
}

