meta {
  name: DEVICE A 토큰 갱신
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/devices/fcm-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{qaTokenA}}
}

body:json {
  {"fcmToken":"qa-fcm-new-{{qaInstallA}}"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("FCM 갱신",function(){expect(res.status).to.equal(204); });
}
