meta {
  name: CONSENT 이전 약관 재동의 거절
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{qaTokenA}}
}

body:json {
  {"agreed":true,"termsVersion":"v1"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("상태와 공통 오류 코드",function(){expect(res.status).to.equal(400); expect(res.body.code).to.equal("INVALID_REQUEST");});
}
