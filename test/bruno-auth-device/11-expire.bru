meta {
  name: AUTH 세션 만료 준비
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"expire","installationId":"{{qaInstallA}}"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("AUTH 세션 만료 준비",function(){expect(res.status).to.equal(200); expect(res.body.expired).to.equal(true);});
}
