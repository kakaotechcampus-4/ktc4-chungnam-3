meta {
  name: ANALYSIS 복구 후 정상 대역
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"configure","videoId":"BrunoStale0","mode":"place"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("ANALYSIS 복구 후 정상 대역",function(){expect(res.status).to.equal(200); });
}
