meta {
  name: ANALYSIS 시작 확인 shared
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"observe","videoId":"BrunoDelay1"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

script:post-response {
if(res.status===200&&res.body.analysisCalls===0&&Date.now()<bru.getVar("qaDeadline")){await bru.sleep(200);bru.runner.setNextRequest("ANALYSIS 시작 확인 shared");}
}

tests {
test("ANALYSIS 시작 확인 shared",function(){expect(res.status).to.equal(200); expect(res.body.activeAnalyses).to.be.above(0);expect(res.body.analysisCalls).to.equal(1);});
}
