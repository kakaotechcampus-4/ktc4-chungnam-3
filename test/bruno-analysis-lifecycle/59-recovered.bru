meta {
  name: ANALYSIS 복구 후 실패 코드
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/api/personal-saves/{{qaSavestale}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{qaTokenA}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("멈춘 분석 FAILED",function(){expect(res.status).to.equal(200); expect(res.body.analysisStatus).to.equal("FAILED");expect(res.body.analysisFailureCode).to.equal("EXTRACTION_API_ERROR");});
}
