meta {
  name: ANALYSIS 삭제한 저장물 재생성 없음 deleted
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/api/personal-saves/{{qaSavedeleted}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{qaTokenA}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("상태와 공통 오류 코드",function(){expect(res.status).to.equal(404); expect(res.body.code).to.equal("NOT_FOUND");});
}
