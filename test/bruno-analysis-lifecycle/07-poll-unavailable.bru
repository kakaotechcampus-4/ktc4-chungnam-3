meta {
  name: ANALYSIS 실패 unavailable
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/personal-saves/{{qaSaveunavailable}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{qaTokenA}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

script:post-response {
const pending=res.status===200 && ["PENDING","ANALYZING"].includes(res.body.analysisStatus);bru.setVar("qaPolling",pending && Date.now()<bru.getVar("qaDeadline"));if(bru.getVar("qaPolling")){await bru.sleep(200);bru.runner.setNextRequest("ANALYSIS 실패 unavailable");}
}

tests {
test("분석 상태와 상세 응답",function(){expect(res.status).to.equal(200); expect(res.body.personalSaveId).to.equal(bru.getVar("qaSaveunavailable"));if(!bru.getVar("qaPolling")){expect(res.body.analysisStatus).to.equal("FAILED");expect(res.body.analysisFailureCode).to.equal("VIDEO_UNAVAILABLE");expect(res.body.places).to.deep.equal([]);}});
}
