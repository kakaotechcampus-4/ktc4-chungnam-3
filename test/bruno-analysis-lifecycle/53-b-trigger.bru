meta {
  name: ANALYSIS B 트리거 생성
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"observe","installationId":"{{qaInstallB}}"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("ANALYSIS B 트리거 생성",function(){expect(res.status).to.equal(200); expect(res.body.triggerCount).to.equal(1);});
}
