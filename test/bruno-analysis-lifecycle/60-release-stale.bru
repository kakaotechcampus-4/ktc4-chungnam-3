meta {
  name: ANALYSIS 이전 작업 해제
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"release","videoId":"BrunoStale0"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("ANALYSIS 이전 작업 해제",function(){expect(res.status).to.equal(200); });
}
