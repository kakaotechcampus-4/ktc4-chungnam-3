meta {
  name: ANALYSIS 오래된 작업 복구
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"recover","videoId":"BrunoStale0"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("ANALYSIS 오래된 작업 복구",function(){expect(res.status).to.equal(200); });
}
