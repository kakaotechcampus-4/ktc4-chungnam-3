meta {
  name: ANALYSIS 이전 작업 종료
  type: http
  seq: 61
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"observe","videoId":"BrunoStale0"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");
if(!bru.getVar("qaObserveDeadline"))bru.setVar("qaObserveDeadline",Date.now()+15000);
}

script:post-response {
const busy=res.status===200 && res.body.activeAnalyses>0;bru.setVar("qaPolling",busy&&Date.now()<bru.getVar("qaObserveDeadline"));if(bru.getVar("qaPolling")){await bru.sleep(200);bru.runner.setNextRequest("ANALYSIS 이전 작업 종료");}else bru.deleteVar("qaObserveDeadline");
}

tests {
test("ANALYSIS 이전 작업 종료",function(){expect(res.status).to.equal(200); if(!bru.getVar("qaPolling")){expect(res.body.activeAnalyses).to.equal(0);}});
}
