meta {
  name: ANALYSIS 준비 api-error
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"configure","videoId":"BrunoFail01","mode":"api-error"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("ANALYSIS 준비 api-error",function(){expect(res.status).to.equal(200); });
}
