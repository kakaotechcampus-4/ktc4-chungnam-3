meta {
  name: EXT 저장 정리
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/personal-saves/{{extSave}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{extToken}}
}

script:pre-request {
if(!bru.getVar("extToken")) throw new Error("외부 연동 Runner를 처음부터 실행하세요.");
if(!bru.getVar("extSave"))throw new Error("생성된 저장물 없음. Runner가 임시 DB를 정리합니다.");
}

tests {
test("HTTP 204 및 단계 결과",function(){expect(res.status).to.equal(204);});
}
