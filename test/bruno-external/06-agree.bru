meta {
  name: EXT 위치 동의
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{extToken}}
}

body:json {
  {"agreed":true,"termsVersion":"{{extTerms}}"}
}

script:pre-request {
if(!bru.getVar("extToken")) throw new Error("외부 연동 Runner를 처음부터 실행하세요.");

}

tests {
test("HTTP 200 및 단계 결과",function(){expect(res.status).to.equal(200);expect(res.body.agreed).to.equal(true);});
}
