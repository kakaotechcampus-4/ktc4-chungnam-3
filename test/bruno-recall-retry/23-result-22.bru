meta {
  name: RETRY 초과 시 추가 호출 없음
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"observe","installationId":"{{qaInstallA}}"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("RETRY 초과 시 추가 호출 없음",function(){expect(res.status).to.equal(200); const e=res.body.executions.filter(e=>e.trigger_event_id===bru.getVar("qaEventlimit"));expect(e).to.have.lengthOf(1);expect(e[0].status).to.equal("FAILED");expect(e[0].retry_count).to.equal(1);const notifications=res.body.notifications.filter(x=>x.execution_id===e[0].id);expect(notifications).to.have.lengthOf(0);expect(res.body.agentCalls).to.equal(bru.getVar("qaBaselineCalls"));});
}
