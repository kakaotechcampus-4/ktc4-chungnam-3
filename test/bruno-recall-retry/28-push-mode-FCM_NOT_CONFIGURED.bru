meta {
  name: PUSH 오류 준비 FCM_NOT_CONFIGURED
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"configure","pushMode":"FCM_NOT_CONFIGURED"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("PUSH 오류 준비 FCM_NOT_CONFIGURED",function(){expect(res.status).to.equal(200); });
}
