meta {
  name: RETRY 마지막 허용 재시도
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/location-events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{qaTokenA}}
}

body:json {
  {"placeId":"{{qaPlace}}","triggerEventId":"{{qaEventlimit}}","eventType":"DWELL","eventOccurredAt":"{{qaEventAt}}","location":{"latitude":36.37,"longitude":127.38,"accuracyMeters":10,"locatedAt":"{{qaEventAt}}"}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");
bru.setVar("qaEventAt",new Date().toISOString());
}

tests {
test("접수만 확인",function(){expect(res.status).to.equal(202); });
}
