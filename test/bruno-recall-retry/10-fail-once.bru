meta {
  name: RETRY 첫 판단만 실패
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"configure","agentMode":"fail-once"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("RETRY 첫 판단만 실패",function(){expect(res.status).to.equal(200); });
}
