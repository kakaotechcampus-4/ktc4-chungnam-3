meta {
  name: PUSH 토큰 없음 실패
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/__bruno/control
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Bruno-Control: {{controlToken}}
}

body:json {
  {"action":"observe","installationId":"{{qaInstallB}}"}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("PUSH 토큰 없음 실패",function(){expect(res.status).to.equal(200); const e=res.body.executions.filter(e=>e.trigger_event_id===bru.getVar("qaEventnoToken"));expect(e).to.have.lengthOf(1);expect(e[0].status).to.equal("COMPLETED");expect(e[0].retry_count).to.equal(0);const notifications=res.body.notifications.filter(x=>x.execution_id===e[0].id);expect(notifications).to.have.lengthOf(1);expect(notifications[0].status).to.equal("FAILED");expect(notifications[0].failure_code).to.equal("NO_FCM_TOKEN");});
}
