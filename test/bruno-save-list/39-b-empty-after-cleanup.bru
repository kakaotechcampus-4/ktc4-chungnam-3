meta {
  name: LIST-39 B 정리 후 빈 목록 - 200
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/api/personal-saves
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{listSessionB}}
}

script:pre-request {
  if (!bru.getVar("listSessionB")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionB가 없습니다."); }
}

tests {
  test("빈 목록과 마지막 커서", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array").with.lengthOf(0);
    expect(res.body.nextCursor).to.equal(null);
  });
}

