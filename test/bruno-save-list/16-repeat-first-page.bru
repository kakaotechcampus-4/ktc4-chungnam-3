meta {
  name: LIST-16 첫 페이지 재조회 - 200
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/personal-saves?size=2
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("listSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionA가 없습니다."); }
  if (!bru.getVar("listCursorA")) { throw new Error("컬렉션을 처음부터 실행하세요: listCursorA가 없습니다."); }
  if (!bru.getVar("listPageOneIds")) { throw new Error("컬렉션을 처음부터 실행하세요: listPageOneIds가 없습니다."); }
}

tests {
  test("데이터 변경 없는 재조회 결과 유지", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.map(function (item) { return item.personalSaveId; })).to.deep.equal(bru.getVar("listPageOneIds"));
    expect(res.body.nextCursor).to.equal(bru.getVar("listCursorA"));
  });
}

