meta {
  name: LIST-32 마지막 페이지의 저장물 삭제 - 204
  type: http
  seq: 32
}

delete {
  url: {{baseUrl}}/api/personal-saves/{{listSaveA1}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("listSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionA가 없습니다."); }
  if (!bru.getVar("listSaveA1")) { throw new Error("컬렉션을 처음부터 실행하세요: listSaveA1가 없습니다."); }
}

tests {
  test("HTTP 204", function () { expect(res.status).to.equal(204); });
}

