meta {
  name: LIST-34 A가 같은 영상을 삭제해도 B 목록 유지 - 200
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/api/personal-saves
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{listSessionB}}
}

script:pre-request {
  if (!bru.getVar("listSessionB")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionB가 없습니다."); }
  if (!bru.getVar("listSaveB")) { throw new Error("컬렉션을 처음부터 실행하세요: listSaveB가 없습니다."); }
}

tests {
  test("B가 저장한 한 건만 반환", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array").with.lengthOf(1);
    expect(res.body.items[0].personalSaveId).to.equal(bru.getVar("listSaveB").personalSaveId);
    expect(res.body.items[0].contentId).to.equal(bru.getVar("listSaveB").contentId);
    expect(res.body.items[0].videoId).to.equal(bru.getVar("listVideo1"));
    expect(res.body.nextCursor).to.equal(null);
  });
}

