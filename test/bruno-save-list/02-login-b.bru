meta {
  name: LIST-02 회원 B 로그인 - 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"installationId":"{{listInstallationB}}"}
}

script:pre-request {
  if (!bru.getVar("listSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionA가 없습니다."); }
  bru.setVar("listInstallationB", require("uuid").v4());
}

tests {
  test("별도 B 세션", function () {
    expect(res.status).to.equal(200);
    expect(res.body.sessionToken).to.be.a("string").and.not.empty;
    bru.setVar("listSessionB", res.body.sessionToken);
  });
}

