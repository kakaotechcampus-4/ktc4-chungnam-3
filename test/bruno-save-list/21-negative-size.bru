meta {
  name: LIST-21 음수 size - 400
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/personal-saves?size=-1
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("listSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: listSessionA가 없습니다."); }
}

tests {
  test("HTTP 400 및 INVALID_REQUEST", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

