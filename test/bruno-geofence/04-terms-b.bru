meta {
  name: GEO-SETUP-03 회원 B 약관 버전 조회 - 200
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/me/consents
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{geoSessionB}}
}

script:pre-request {
  if (!bru.getVar("geoSessionB")) { throw new Error("컬렉션을 처음부터 실행하세요: geoSessionB가 없습니다."); }
}

tests {
  test("신규 회원의 위치 미동의와 현재 버전", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    const item = res.body.find(function (value) { return value.consentType === "LOCATION_BASED_SERVICE"; });
    expect(item.agreed).to.equal(false);
    expect(item.currentTermsVersion).to.be.a("string").and.not.empty;
    bru.setVar("geoTermsB", item.currentTermsVersion);
  });
}
