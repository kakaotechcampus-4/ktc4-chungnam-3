meta {
  name: GEO-SETUP-07 확정 장소와 좌표 준비 - 200
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/personal-saves/{{geoSaveId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("geoSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: geoSessionA가 없습니다."); }
  if (!bru.getVar("geoSaveId")) { throw new Error("컬렉션을 처음부터 실행하세요: geoSaveId가 없습니다."); }
}

tests {
  test("분석 성공과 확정 장소 최소 한 곳", function () {
    expect(res.status).to.equal(200);
    expect(res.body.personalSaveId).to.equal(bru.getVar("geoSaveId"));
    expect(res.body.contentId).to.equal(bru.getVar("geoContentId"));
    expect(res.body.videoId).to.equal(bru.getVar("geoVideoId"));
    expect(res.body.analysisStatus).to.equal("SUCCESS");
    expect(res.body.places).to.be.an("array").and.not.empty;
    res.body.places.forEach(function (place) {
      expect(place.placeId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      expect(place.latitude).to.be.a("number").and.within(-90,90);
      expect(place.longitude).to.be.a("number").and.within(-180,180);
    });
    bru.setVar("geoExpectedPlaces", res.body.places);
    bru.setVar("geoLatitude", res.body.places[0].latitude);
    bru.setVar("geoLongitude", res.body.places[0].longitude);
  });
}
