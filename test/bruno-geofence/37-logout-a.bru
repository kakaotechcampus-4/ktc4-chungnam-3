meta {
  name: GEO-CLEANUP 회원 A 로그아웃 - 204
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{geoSessionA}}
}

script:pre-request {
  if (!bru.getVar("geoSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: geoSessionA가 없습니다."); }
}

tests {
  test("회원 A 로그아웃", function () { expect(res.status).to.equal(204); });
  if (res.status === 204) { bru.deleteVar("geoSessionA"); }
}
