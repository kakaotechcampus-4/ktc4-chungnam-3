meta {
  name: GEO-SETUP-09 회원 A 위치 동의 철회 - 200
  type: http
  seq: 28
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agreed": false
  }
}

script:pre-request {
  if (!bru.getVar("geoSessionA")) { throw new Error("컬렉션을 처음부터 실행하세요: geoSessionA가 없습니다."); }
}

tests {
  test("위치 동의 철회", function () {
    expect(res.status).to.equal(200);
    expect(res.body.agreed).to.equal(false);
    expect(Number.isFinite(Date.parse(res.body.withdrawnAt))).to.equal(true);
  });
}
