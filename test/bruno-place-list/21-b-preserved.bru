meta {
  name: PLACES A 삭제 후 B 유지
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/personal-saves/places
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{qaTokenB}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("B 출처 보존",function(){expect(res.status).to.equal(200); expect(res.body).to.have.lengthOf(1);expect(res.body[0].personalSaveId).to.equal(bru.getVar("qaSaveB0"));});
}
