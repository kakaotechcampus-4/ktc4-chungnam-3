meta {
  name: PLACES 장소 없는 콘텐츠
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/personal-saves/places
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{qaTokenA}}
}

script:pre-request {
if(!bru.getVar("qaReady")) throw new Error("test/harness/run.sh로 임시 환경을 준비하고 전체 Runner를 실행하세요.");

}

tests {
test("장소 없는 영상은 핀을 만들지 않음",function(){expect(res.status).to.equal(200); expect(res.body).to.deep.equal(bru.getVar("qaPins"));});
}
