meta {
  name: CONFIRM-ANSWER 이미 답한 후보 재제출 - 404
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/personal-saves/{{confirmSaveA}}/places/{{confirmCandidate}}/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {{confirmAnswerBody}}
}

script:pre-request {
if (!bru.getVar("confirmSessionA") || !bru.getVar("confirmSaveA")) { throw new Error("컬렉션을 처음부터 실행하세요."); }
}

tests {
test("HTTP 상태와 오류 코드", function () { expect(res.status).to.equal(404); expect(res.body.code).to.equal("NOT_FOUND"); expect(res.body.message).to.be.a("string").and.not.empty; });
}
