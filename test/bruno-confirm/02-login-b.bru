meta {
  name: CONFIRM-SETUP B 로그인 - 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"installationId":"{{confirmInstallationB}}"}
}

tests {
test("회원 B 세션 발급", function () { expect(res.status).to.equal(200); expect(res.body.sessionToken).to.be.a("string").and.not.empty; expect(res.body.sessionToken).not.to.equal(bru.getVar("confirmSessionA")); bru.setVar("confirmSessionB",res.body.sessionToken); });
}
