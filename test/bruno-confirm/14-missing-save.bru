meta {
  name: CONFIRM-ERROR 없는 저장물 - 404
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/personal-saves/{{confirmMissingSave}}/places/{{confirmCandidate}}/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {{confirmAnswerBody}}
}

script:pre-request {
if (!bru.getVar("confirmSessionA") || !bru.getVar("confirmSaveA")) { throw new Error("컬렉션을 처음부터 실행하세요."); }
if(!bru.getVar("confirmCandidate")) throw new Error("미응답 후보를 먼저 준비하세요.");
}

script:post-response {
  if(res.status!==404 || !res.body || res.body.code!=="NOT_FOUND") bru.setVar("confirmChecksFailed",true);
}

tests {
test("HTTP 상태와 오류 코드", function () { expect(res.status).to.equal(404); expect(res.body.code).to.equal("NOT_FOUND"); expect(res.body.message).to.be.a("string").and.not.empty; });
}
