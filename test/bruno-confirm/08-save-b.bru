meta {
  name: CONFIRM-SETUP B 영상 저장 - 201
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/personal-saves
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{confirmSessionB}}
}

body:json {
  {"url":"{{confirmUrl}}"}
}

tests {
test("서로 다른 개인 저장물, 동일 공용 콘텐츠", function () { expect(res.status).to.equal(201); expect(res.body.personalSaveId).to.be.a("string").and.not.empty; bru.setVar("confirmSaveB",res.body.personalSaveId); expect(res.body.contentId).to.equal(bru.getVar("confirmContent")); expect(res.body.personalSaveId).not.to.equal(bru.getVar("confirmSaveA")); });
}
