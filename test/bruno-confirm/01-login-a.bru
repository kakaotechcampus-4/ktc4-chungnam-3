meta {
  name: CONFIRM-SETUP A 로그인 - 200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"installationId":"{{confirmInstallationA}}"}
}

script:pre-request {
Object.keys(bru.getAllVars()).filter(k=>k.startsWith("confirm")).forEach(k=>bru.deleteVar(k));
const base=bru.getEnvVar("baseUrl"); if(!/^https?:\/\/[^/]+$/.test(base||"")) throw new Error("baseUrl은 마지막 / 없이 입력하세요.");
const mode=bru.getEnvVar("confirmAction"); if(!["validate","select","reject"].includes(mode)) throw new Error("confirmAction은 validate/select/reject 중 하나여야 합니다.");
const match=/^https?:\/\/(?:www\.|m\.)?youtube\.com\/shorts\/([A-Za-z0-9_-]{11})\/?(?:[?#].*)?$/.exec(bru.getEnvVar("shortsUrl")||""); if(!match) throw new Error("후보가 있는 공개 Shorts URL이 필요합니다.");
const interval=Number(bru.getEnvVar("pollIntervalMs")), timeout=Number(bru.getEnvVar("analysisTimeoutMs")); if(!Number.isInteger(interval)||interval<1000||interval>30000||!Number.isInteger(timeout)||timeout<interval||timeout>900000) throw new Error("폴링 설정을 확인하세요.");
bru.setVar("confirmUrl","https://www.youtube.com/shorts/"+match[1]); bru.setVar("confirmMode",mode); bru.setVar("confirmInstallationA",require("uuid").v4()); bru.setVar("confirmInstallationB",require("uuid").v4()); bru.setVar("confirmMissingSave",require("uuid").v4()); bru.setVar("confirmMissingCandidate","qa-"+require("uuid").v4()); bru.setVar("confirmMissingOption","qa-"+require("uuid").v4());
// 후보 준비 실패 시에도 삭제 후 빈 지오펜스 조회를 실행할 수 있는 유효 좌표.
bru.setVar("confirmLatitude",36.37); bru.setVar("confirmLongitude",127.38);
}

tests {
test("회원 A 세션 발급", function () { expect(res.status).to.equal(200); expect(res.body.sessionToken).to.be.a("string").and.not.empty; bru.setVar("confirmSessionA",res.body.sessionToken); });
}
