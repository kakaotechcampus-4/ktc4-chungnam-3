meta {
  name: CONFIRM-GEO A 장소 반영 - 200
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/geofences?latitude={{confirmLatitude}}&longitude={{confirmLongitude}}&platform=ANDROID
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{confirmSessionA}}
}

tests {
test("장소 ID와 좌표 및 회원별 등록 목록", function () { expect(res.status).to.equal(200); expect(res.body.regions).to.deep.equal([]); expect(res.body.places).to.be.an("array"); const expected=bru.getVar("confirmAfter").places; expect(expected.length,"이 테스트는 99개 이하 장소 데이터가 필요함").to.be.at.most(99); expect(res.body.places.map(p=>p.placeId)).to.have.members(expected.map(p=>p.placeId)); res.body.places.forEach(p=>{const e=expected.find(x=>x.placeId===p.placeId); expect(p.latitude).to.equal(e.latitude); expect(p.longitude).to.equal(e.longitude); expect(p.geofenceId).to.equal("place:"+e.placeId);}); });
}
