meta {
  name: CONFIRM-ANSWER 같은 영상을 저장한 B에도 반영 - 200
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/personal-saves/{{confirmSaveB}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{confirmSessionB}}
}

tests {
test("공용 콘텐츠 변경과 개인 저장물 구분", function () { expect(res.status).to.equal(200); expect(res.body.personalSaveId).to.equal(bru.getVar("confirmSaveB")); expect(res.body.contentId).to.equal(bru.getVar("confirmContent")); const normalized = function (body) { const copy = JSON.parse(JSON.stringify(body)); copy.places.sort((a,b)=>a.placeId.localeCompare(b.placeId)); copy.confirmCandidates.sort((a,b)=>a.candidateId.localeCompare(b.candidateId)); return copy; }; const actual=normalized(res.body), after=bru.getVar("confirmAfter"); expect(actual.places).to.deep.equal(after.places); expect(actual.confirmCandidates).to.deep.equal(after.confirmCandidates); });
}
