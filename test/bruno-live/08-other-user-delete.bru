meta {
  name: LIVE-SAVE-06 다른 회원 삭제 차단 - 404
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/personal-saves/{{livePersonalSaveId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{liveSessionTokenB}}
}

script:pre-request {
  if (!bru.getVar("liveSessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: liveSessionTokenB가 없습니다."); }
  if (!bru.getVar("livePersonalSaveId")) { throw new Error("컬렉션을 처음부터 실행하세요: livePersonalSaveId가 없습니다."); }
}

tests {
  test("HTTP 404 및 NOT_FOUND", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
