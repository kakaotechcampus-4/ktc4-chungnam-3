meta {
  name: AUTH-03 회원 B 로그아웃 세션 차단 - 401
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/me/consents
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionTokenB}}
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
}

tests {
  test("HTTP 401 및 오류 형식", function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("INVALID_SESSION");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
  if (res.status === 401 && res.body.code === "INVALID_SESSION") {
    ["sessionToken","sessionTokenA","sessionTokenB","previousSessionTokenA","installationId","installationIdB"].forEach(function (key) { bru.deleteVar(key); });
  }
}
