meta {
  name: AUTH-GUEST-01 새 테스트 회원 로그인 - 200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "installationId": "{{installationId}}"
  }
}

script:pre-request {
  bru.deleteVar("sessionToken");
  bru.deleteVar("locationTermsVersion");
  bru.deleteVar("firstAgreedAt");
  bru.deleteVar("reagreedAt");
  bru.setVar("installationId", require("uuid").v4());
}

tests {
  test("게스트 세션 발급", function () {
    expect(res.status).to.equal(200);
    expect(res.body.sessionToken).to.be.a("string").and.not.empty;
    expect(Number.isFinite(Date.parse(res.body.sessionExpiresAt))).to.equal(true);
    expect(Date.parse(res.body.sessionExpiresAt)).to.be.above(Date.now());
    bru.setVar("sessionToken", res.body.sessionToken);
  });
}
