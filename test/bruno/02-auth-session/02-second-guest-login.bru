meta {
  name: AUTH-GUEST-03 테스트 회원 B 로그인 - 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "installationId": "{{installationIdB}}"
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  bru.setVar("sessionTokenA", bru.getVar("sessionToken"));
  bru.deleteVar("sessionTokenB");
  bru.setVar("installationIdB", require("uuid").v4());
}

tests {
  test("별도 게스트 세션 발급", function () {
    expect(res.status).to.equal(200);
    expect(res.body.sessionToken).to.be.a("string").and.not.empty;
    expect(Number.isFinite(Date.parse(res.body.sessionExpiresAt))).to.equal(true);
    expect(Date.parse(res.body.sessionExpiresAt)).to.be.above(Date.now());
    bru.setVar("sessionTokenB", res.body.sessionToken);
  });
}
