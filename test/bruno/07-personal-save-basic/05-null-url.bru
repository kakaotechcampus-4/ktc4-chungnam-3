meta {
  name: SAVE-BASIC-02 URL null - 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/personal-saves
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "url": null
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 게스트 로그인부터 실행하세요. 컬렉션 전체 실행을 권장합니다."); }
}

tests {
  test("HTTP 400 및 INVALID_REQUEST", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
