meta {
  name: SAVE-BASIC-04 없는 저장물 삭제 - 404
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/personal-saves/{{missingPersonalSaveId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 게스트 로그인부터 실행하세요. 컬렉션 전체 실행을 권장합니다."); }
  if (!bru.getVar("missingPersonalSaveId")) { throw new Error("07-personal-save-basic의 01번 요청부터 실행하세요."); }
}

tests {
  test("HTTP 404 및 NOT_FOUND", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
