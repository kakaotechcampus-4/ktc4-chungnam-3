meta {
  name: CON-02 위치 동의 저장 - 200
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agreed": true,
    "termsVersion": "{{locationTermsVersion}}"
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 02-auth-session의 게스트 로그인을 실행하세요."); }
  if (!bru.getVar("locationTermsVersion")) { throw new Error("03-consent 폴더를 01번부터 실행하세요."); }
}

tests {
  test("HTTP 200", function () { expect(res.status).to.equal(200); });
  test("동의 시각 기록", function () {
    expect(res.body.consentType).to.equal("LOCATION_BASED_SERVICE");
    expect(res.body.agreed).to.equal(true);
    expect(res.body.termsVersion).to.equal(bru.getVar("locationTermsVersion"));
    expect(Number.isFinite(Date.parse(res.body.agreedAt))).to.equal(true);
    expect(res.body.withdrawnAt).to.equal(null);
  });
}
