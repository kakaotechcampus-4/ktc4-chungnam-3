meta {
  name: CON-03 위치 동의 철회 - 200
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agreed": false
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 02-auth-session의 게스트 로그인을 실행하세요."); }
  if (!bru.getVar("locationTermsVersion")) { throw new Error("03-consent 폴더를 01번부터 실행하세요."); }
}

tests {
  test("HTTP 200", function () { expect(res.status).to.equal(200); });
  test("철회 시각 기록 및 기존 동의 시각 유지", function () {
    expect(bru.getVar("firstAgreedAt")).to.be.a("string").and.not.empty;
    expect(res.body.agreed).to.equal(false);
    expect(res.body.agreedAt).to.equal(bru.getVar("firstAgreedAt"));
    expect(Number.isFinite(Date.parse(res.body.withdrawnAt))).to.equal(true);
    expect(Date.parse(res.body.withdrawnAt)).to.be.at.least(Date.parse(res.body.agreedAt));
  });
}
