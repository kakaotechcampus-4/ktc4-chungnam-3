meta {
  name: EVT-HTTP-03 선택 위치 null 접수 - 202
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/location-events
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "placeId": "{{evtPlaceId}}",
    "triggerEventId": "{{evtEventId}}",
    "eventType": "ENTER",
    "eventOccurredAt": "{{evtNow}}",
    "location": null
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 02-auth-session의 게스트 로그인을 실행하세요. 컬렉션 전체 실행을 권장합니다."); }
  bru.setVar("evtPlaceId", require("uuid").v4());
  bru.setVar("evtEventId", require("uuid").v4());
  bru.setVar("evtNow", new Date().toISOString());
}

tests {
  test("HTTP 202 및 빈 응답 - 실행 생성 검증은 아님", function () {
    expect(res.status).to.equal(202);
    expect(res.body === "" || res.body === null || res.body === undefined).to.equal(true);
  });
}
