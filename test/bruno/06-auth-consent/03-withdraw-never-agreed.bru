meta {
  name: CON-07 회원 B 동의 이력 없이 철회 - 200
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sessionTokenB}}
}

body:json {
  {
    "agreed": false
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
}

tests {
  test("없는 이력을 새로 만들지 않음", function () {
    expect(res.status).to.equal(200);
    expect(res.body.consentType).to.equal("LOCATION_BASED_SERVICE");
    expect(res.body.agreed).to.equal(false);
    expect(res.body.termsVersion).to.equal(null);
    expect(res.body.agreedAt).to.equal(null);
    expect(res.body.withdrawnAt).to.equal(null);
  });
}
