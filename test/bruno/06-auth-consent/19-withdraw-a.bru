meta {
  name: CON-09 반복 철회 준비 - 200
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sessionTokenA}}
}

body:json {
  {
    "agreed": false
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
}

tests {
  test("최초 철회 기록", function () {
    expect(res.status).to.equal(200);
    expect(res.body.agreed).to.equal(false);
    expect(Number.isFinite(Date.parse(res.body.agreedAt))).to.equal(true);
    expect(Number.isFinite(Date.parse(res.body.withdrawnAt))).to.equal(true);
    bru.setVar("repeatWithdrawalAgreedAt", Date.parse(res.body.agreedAt));
    bru.setVar("firstWithdrawnAt", Date.parse(res.body.withdrawnAt));
  });
}
