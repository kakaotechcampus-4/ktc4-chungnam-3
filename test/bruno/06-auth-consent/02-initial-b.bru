meta {
  name: CON-06 A의 동의가 신규 회원 B에게 노출되지 않음 - 200
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/me/consents
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionTokenB}}
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
}

tests {
  test("회원 B는 두 유형 모두 미동의", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array").with.lengthOf(2);
    expect(res.body.map(function (item) { return item.consentType; })).to.have.members(["LOCATION_BASED_SERVICE","PUBLIC_CANDIDATE_CONTRIBUTION"]);
    res.body.forEach(function (item) {
      expect(item.agreed).to.equal(false);
      expect(item.termsVersion).to.equal(null);
      expect(item.agreedAt).to.equal(null);
      expect(item.withdrawnAt).to.equal(null);
      expect(item.currentTermsVersion).to.be.a("string").and.not.empty;
    });
    bru.setVar("publicTermsVersionB", res.body.find(function (item) { return item.consentType === "PUBLIC_CANDIDATE_CONTRIBUTION"; }).currentTermsVersion);
  });
}
