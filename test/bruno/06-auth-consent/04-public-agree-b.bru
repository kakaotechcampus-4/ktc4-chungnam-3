meta {
  name: CON-08 회원 B 공용 후보 동의 - 200
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/me/consents/PUBLIC_CANDIDATE_CONTRIBUTION
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sessionTokenB}}
}

body:json {
  {
    "agreed": true,
    "termsVersion": "{{publicTermsVersionB}}"
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
  if (!bru.getVar("publicTermsVersionB")) { throw new Error("컬렉션을 처음부터 실행하세요: publicTermsVersionB가 없습니다."); }
}

tests {
  test("공용 후보 동의 저장", function () {
    expect(res.status).to.equal(200);
    expect(res.body.consentType).to.equal("PUBLIC_CANDIDATE_CONTRIBUTION");
    expect(res.body.agreed).to.equal(true);
    expect(res.body.termsVersion).to.equal(bru.getVar("publicTermsVersionB"));
    expect(Number.isFinite(Date.parse(res.body.agreedAt))).to.equal(true);
    expect(res.body.withdrawnAt).to.equal(null);
  });
}
