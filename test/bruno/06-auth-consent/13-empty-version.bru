meta {
  name: CON-05 동의 시 약관 버전 빈 값 - 400
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/me/consents/LOCATION_BASED_SERVICE
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sessionTokenA}}
}

body:json {
  {
    "agreed": true,
    "termsVersion": ""
  }
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionToken가 없습니다."); }
  if (!bru.getVar("sessionTokenA")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenA가 없습니다."); }
  if (!bru.getVar("sessionTokenB")) { throw new Error("컬렉션을 처음부터 실행하세요: sessionTokenB가 없습니다."); }
  if (!bru.getVar("locationTermsVersion")) { throw new Error("컬렉션을 처음부터 실행하세요: locationTermsVersion가 없습니다."); }
}

tests {
  test("HTTP 400 및 오류 형식", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
