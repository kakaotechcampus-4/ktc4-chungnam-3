meta {
  name: DEVICE-12 513자 토큰 거절 - 400
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/devices/fcm-token
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {"fcmToken":"{{deviceTooLongFcmToken}}"}
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 02-auth-session의 게스트 로그인을 실행하세요. 컬렉션 전체 실행을 권장합니다."); }
  const prefix = "qa-fcm-" + require("uuid").v4();
  bru.setVar("deviceTooLongFcmToken", prefix.padEnd(513, "x"));
}

tests {
  test("HTTP 400 및 INVALID_REQUEST", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

