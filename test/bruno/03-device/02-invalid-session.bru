meta {
  name: DEVICE-02 임의 세션으로 등록 - 401
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/devices/fcm-token
  body: json
  auth: bearer
}

auth:bearer {
  token: invalid-test-session
}

headers {
  Content-Type: application/json
}

body:json {
  {"fcmToken":"qa-device-invalid-session"}
}

tests {
  test("HTTP 401 및 INVALID_SESSION", function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("INVALID_SESSION");
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}

