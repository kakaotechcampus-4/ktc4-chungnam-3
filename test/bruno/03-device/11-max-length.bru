meta {
  name: DEVICE-11 512자 토큰 등록 접수 - 204
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/devices/fcm-token
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {"fcmToken":"{{deviceBoundaryFcmToken}}"}
}

script:pre-request {
  if (!bru.getVar("sessionToken")) { throw new Error("먼저 02-auth-session의 게스트 로그인을 실행하세요. 컬렉션 전체 실행을 권장합니다."); }
  const prefix = "qa-fcm-" + require("uuid").v4();
  bru.setVar("deviceBoundaryFcmToken", prefix.padEnd(512, "x"));
}

tests {
  test("HTTP 204 및 빈 응답", function () {
    expect(res.status).to.equal(204);
    expect(res.body).to.be.oneOf(["", null, undefined]);
  });
}

